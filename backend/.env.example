# ── Database ────────────────────────────────────────────────────────────────
# Production: PostgreSQL (required for LangGraph PostgresSaver on Day 3)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/business_assistant
# Dev/test fallback (no Postgres needed):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── LLM provider (anthropic | openai | google) ───────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-5

# ── API keys (only the one matching LLM_PROVIDER is required) ───────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
